<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for the web board server. backlog-md-schedule fills in __SCRIPT__, __LOG__, and __PATH__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kurtpreston.backlog-md-browser</string>

  <!-- Run the server script with the PATH of the shell that installed the job, so it finds node and backlog -->
  <key>ProgramArguments</key>
  <array>
    <string>__SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <!-- Start at login and restart the server if it exits, waiting 30 seconds between attempts -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- Keep output for troubleshooting -->
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
