// Machine-specific settings for the backlog-md plugin. Copy this file to config.jsonc,
// which git ignores, and edit it there. A missing config.jsonc means every default below.
{
  "sync": {
    // Keep the board in step with a private git remote shared by your machines. When false,
    // the board stays local and a nightly job commits each day's changes.
    "enabled": false,

    // The remote's URL, such as an SSH URL on a self-hosted git server.
    "remote": "",

    // The branch every machine commits to.
    "branch": "main",
  },

  "browser": {
    // Serve the web board from a launchd job that starts at login and restarts if it exits.
    "enabled": true,

    // The board's port on 127.0.0.1.
    "port": 6420,
  },

  "delegation": {
    // What /sidequest does once a task holds its agent brief:
    //   "handoff": print the folder and a prompt for you to start an agent yourself
    //   "launch":  start an agent now, in the background, by running `command`
    //   "queue":   label the task for something that watches the board, such as docent, and stop
    // Only "queue" adds the label, so a watcher never picks up a task already handed off another way.
    "mode": "handoff",

    // The label a board watcher looks for. Used only in "queue" mode.
    "label": "agent",

    // The agent CLI that "launch" mode runs, one argument per string. {prompt} becomes the prompt
    // pointing the agent at the task, and {folder} the checkout it runs in. For Claude Code, use
    // ["claude", "-p", "{prompt}", "--dangerously-skip-permissions"].
    "command": ["copilot", "-p", "{prompt}", "--allow-all-tools"],
  },
}
